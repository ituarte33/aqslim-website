# Clerk — get these from clerk.com after creating your app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Internal evaluator emails — Preview branch only, comma separated
MYAQ_PREVIEW_REVIEWER_EMAILS=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/food-scanner

# Airtable — never commit the real values
AIRTABLE_PAT=pat...
AIRTABLE_BASE_ID=appuUHRs26ATXnZjf

# Resend — already in Vercel, copy to .env.local for local dev
RESEND_API_KEY=re_...

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Square subscription webhook
SQUARE_PLAN_WEBHOOK_SIGNATURE_KEY=
SQUARE_SUBSCRIPTION_VARIATION_MID=Regular
SQUARE_SUBSCRIPTION_VARIATION_TOP=Plus
